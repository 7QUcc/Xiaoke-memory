{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/pre_compact_save.py" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/post_compact_restore.py" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/ob_recall.py", "timeout": 6 }
        ]
      }
    ]
  }
}
